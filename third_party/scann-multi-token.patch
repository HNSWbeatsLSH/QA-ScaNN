+Status AddMultiTokenizationToOptions(SingleMachineFactoryOptions& opts,
+                                     vector<int32_t> tokens,
+                                     vector<int64_t> offsets,
+                                     vector<uint8_t> codes,
+                                     const vector<size_t>& codes_shape) {
+  if (opts.serialized_partitioner == nullptr)
+    return FailedPreconditionError(
+        "Multi-token tokenization but no serialized partitioner is present.");
+  // Codes may be omitted (codes_shape empty) for a non-residual index, whose
+  // code does not depend on the leaf: every copy then shares the point's
+  // single row of AH_DATASET_NPY.
+  const bool has_codes = !codes_shape.empty();
+  if (opts.datapoints_by_token || opts.soar_hashed_dataset ||
+      (has_codes && opts.hashed_dataset)) {
+    return InvalidArgumentError(
+        "Multi-token assets cannot be combined with TOKENIZATION_NPY or "
+        "AH_DATASET_SOAR_NPY, and AH_DATASET_MULTI_NPY not with "
+        "AH_DATASET_NPY.");
+  }
+  if (!has_codes && !opts.hashed_dataset) {
+    return InvalidArgumentError(
+        "Multi-token tokenization without AH_DATASET_MULTI_NPY needs "
+        "AH_DATASET_NPY.");
+  }
+  if (offsets.empty() || offsets.front() != 0 ||
+      offsets.back() != static_cast<int64_t>(tokens.size())) {
+    return InvalidArgumentError(
+        "TOKENIZATION_MULTI_OFFSETS_NPY must start at 0 and end at the "
+        "number of tokens.");
+  }
+  if (has_codes && codes_shape[0] != tokens.size()) {
+    return InvalidArgumentError(
+        "AH_DATASET_MULTI_NPY must have one row per (datapoint, token) pair.");
+  }
+  const size_t n = offsets.size() - 1;
+  const int32_t n_tokens = opts.serialized_partitioner->n_tokens();
+  opts.datapoints_by_token =
+      std::make_shared<vector<std::vector<DatapointIndex>>>(n_tokens);
+  for (size_t i = 0; i < n; ++i) {
+    if (offsets[i + 1] <= offsets[i]) {
+      return InvalidArgumentError(absl::StrCat(
+          "Datapoint ", i, " has no tokens in TOKENIZATION_MULTI_NPY."));
+    }
+    for (int64_t j = offsets[i]; j < offsets[i + 1]; ++j) {
+      const int32_t token = tokens[j];
+      if (token < 0 || token >= n_tokens) {
+        return InvalidArgumentError(
+            absl::StrCat("Token ", token, " of datapoint ", i,
+                         " is out of range [0, ", n_tokens, ")."));
+      }
+      opts.datapoints_by_token->at(token).push_back(i);
+    }
+  }
+  if (!has_codes) {
+    if (opts.hashed_dataset->size() != n) {
+      return InvalidArgumentError(
+          "AH_DATASET_NPY must have one row per datapoint.");
+    }
+    return OkStatus();
+  }
+  auto multi = std::make_shared<MultiTokenHashedDataset>();
+  multi->codes =
+      std::make_unique<DenseDataset<uint8_t>>(std::move(codes), tokens.size());
+  const size_t code_len = multi->codes->dimensionality();
+
+  vector<uint8_t> primary(n * code_len);
+  for (size_t i = 0; i < n; ++i) {
+    DatapointPtr<uint8_t> row = (*multi->codes)[offsets[i]];
+    std::copy(row.values(), row.values() + code_len,
+              primary.begin() + i * code_len);
+  }
+  opts.hashed_dataset =
+      std::make_shared<DenseDataset<uint8_t>>(std::move(primary), n);
+  multi->tokens = std::move(tokens);
+  multi->offsets = std::move(offsets);
+  opts.multi_token_hashed_dataset = std::move(multi);
+  return OkStatus();
+}
