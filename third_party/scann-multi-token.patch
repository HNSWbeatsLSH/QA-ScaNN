+void DeduplicateDatabaseSpilledResults(NNResultsVector* results,
+                                       size_t final_size,
+                                       int multi_spill_dedup) {
+  if (multi_spill_dedup == kMultiSpillDedupStock) {
+    DeduplicateDatabaseSpilledResults(results, final_size);
+    return;
+  }
+  DCHECK_GT(final_size, 0);
+  flat_hash_map<DatapointIndex, pair<float, uint32_t>> map;
+  map.reserve(results->size());
+  for (const auto& neighbor : *results) {
+    auto [it, was_inserted] =
+        map.try_emplace(neighbor.first, neighbor.second, 1u);
+    if (!was_inserted) {
+      if (multi_spill_dedup == kMultiSpillDedupMin) {
+        it->second.first = std::min(it->second.first, neighbor.second);
+      } else if (multi_spill_dedup == kMultiSpillDedupMax) {
+        it->second.first = std::max(it->second.first, neighbor.second);
+      } else {
+        it->second.first += neighbor.second;
+        it->second.second++;
+      }
+    }
+  }
+  size_t k = 0;
+  for (const auto& [dp_idx, sum_and_count] : map) {
+    (*results)[k++] = {dp_idx, sum_and_count.first / sum_and_count.second};
+  }
+  results->resize(k);
+  if (results->size() > final_size) {
+    NthElementBranchOptimized(results->begin(),
+                              results->begin() + final_size - 1, results->end(),
+                              DistanceComparatorBranchOptimized());
+    results->resize(final_size);
+  }
+}
